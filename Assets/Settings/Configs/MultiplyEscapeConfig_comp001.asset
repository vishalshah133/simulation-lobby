  ballSpeed: 5
  cloneTurnDegrees: {x: 20, y: 70}
  fillTarget: 300
  cloneChance: 0.6
  startGapDegrees: 24
  gapDegreesPerEscape: 1.5
  gapAngularSpeed: 25
  gapCenterDegrees: 90
  roundCount: 1
  maxRoundSeconds: 38
