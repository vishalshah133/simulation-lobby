  m_Name: EscapeConfig_002
  m_EditorClassIdentifier: SimulationLobby.Simulations.Escape::SimulationLobby.Simulations.Escape.EscapeConfig
  fixedTimestep: 0.01
  maxDurationSeconds: 178.8
  intent: 'esc-002 "The Exit Keeps Moving". Same series structure as esc-001 (7 rounds,
    growth x1.035/bounce, gap 24deg, trapped at +10%) with one new variable: the gap
    rotates at +-20deg/s, direction drawn from the seed each attempt. Initial speed
    range widened to 6-13 (from esc-001''s 8-10) so attempts read as genuinely varied
    rather than a narrow band around 9 - direction was already full-circle random via
    NextDirection2D, only the speed band needed opening up.'
  initialSizeFractionMin: 0.07692308
  initialSizeFractionMax: 0.09090909
  randomizeSizePerAttempt: 0
  speedMin: 6
  speedMax: 13
  attemptCount: 7
  maxAttemptSeconds: 24
  interAttemptSeconds: 0.8
  trappedMarginFraction: 0.1
  growth:
    mode: 1
    magnitude: 1.035
    startValue: 1
    maxValue: 6
    minValue: 0.1
  gapDegrees: 24
  gapCenterDegrees: 90
  gapAngularSpeed: 20
  gapDirectionSeeded: 1
  nearMissGapWidths: 1
