  m_Script: {fileID: 11500000, guid: 6217444e4d7a3bd42a3b09220ee87b37, type: 3}
  m_Name: HydraulicPressConfig_001
  m_EditorClassIdentifier: SimulationLobby.Simulations.HydraulicPress::SimulationLobby.Simulations.HydraulicPress.HydraulicPressConfig
  fixedTimestep: 0.016666668
  maxDurationSeconds: 120
  intent: press-001 Split Press. One question (how many balls before the press stops?)
    asked six times, the press 2x stronger each round. Every crushed ball splits
    in 2 smaller balls; each holds 1 ton. The seed only moves the starting ball and
    the split axes; colours are cosmetic.
  rounds:
  - pressTons: 2
    pressLabel: 2 TONS
    caption: A 2-TON PRESS. GUESS?
    result: '{n} BALLS.'
    maxRunSeconds: 6
    expectedRunSeconds: 2.9
  - pressTons: 4
    pressLabel: 4 TONS
    caption: "2× STRONGER: 4 TONS. GUESS?"
    result: '{n} BALLS.'
    maxRunSeconds: 6
    expectedRunSeconds: 3.1
  - pressTons: 8
    pressLabel: 8 TONS
    caption: 8 TONS. GUESS?
    result: '{n} BALLS. NOT DOUBLE...'
    maxRunSeconds: 10
    expectedRunSeconds: 3.6
  - pressTons: 16
    pressLabel: 16 TONS
    caption: 16 TONS. GUESS?
    result: '{n} BALLS.'
    maxRunSeconds: 14
    expectedRunSeconds: 5.7
  - pressTons: 32
    pressLabel: 32 TONS
    caption: 32 TONS. GUESS?
    result: '{n} BALLS!'
    maxRunSeconds: 20
    expectedRunSeconds: 7.9
  - pressTons: 64
    pressLabel: 64 TONS
    caption: 64 TONS. GUESS?
    result: '{n} BALLS!'
    maxRunSeconds: 32
    expectedRunSeconds: 12.9
  chamberWidth: 6
  chamberHeight: 7
  startRadius: 0.9
  startOffset: 0.6
  ballStrengthTons: 1
  ballWeightTons: 0
  pressSpeed: 2.5
  squeezeSeconds: 0.12
  squeezeDecay: 0
  splitJitterDegrees: 3
  loadTolerance: 0.15
  loadSmoothing: 0.04
  calmSpeed: 0.5
  minRadius: 0.008
  maxPopsPerTick: 64
  settleSpeed: 0.1
  stopHoldSeconds: 0.5
  substeps: 3
  iterations: 4
  relaxIterations: 16
  contactTolerance: 0.1
  gravity: 4
  damping: 0.5
  friction: 0.05
  maxSpeed: 6
  maxBalls: 5000
  firstHoldSeconds: 1.5
  holdSeconds: 1
  resultHoldSeconds: 1.6
  transitionSeconds: 1.6
  endCardSeconds: 4
  title: CRUSHED BALLS SPLIT IN 2
  question: HOW MANY BALLS STOP THE PRESS?
  subCaption: EACH BALL HOLDS 1 TON
